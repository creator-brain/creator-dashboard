# Use a Notion personal access token with the Notion API capability, or an
# internal connection API token with read/update content access.
# If using an internal connection, add it to the 💌 Collab Tracker database.
NOTION_TOKEN=
PORT=3001

# Google Cloud OAuth Web application; keep these server-side only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GMAIL_COOKIE_KEY=
GMAIL_REDIRECT_URI=http://127.0.0.1:3001/api/gmail/auth/callback
GMAIL_APP_ORIGIN=http://127.0.0.1:5173

# Configure one Instagram professional account. Keep the token and key server side.
META_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
META_INBOX_KEY=

# Optional Meta webhook verification and signature validation.
META_CLIENT_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
