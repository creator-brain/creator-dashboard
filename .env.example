# Use a Notion personal access token with the Notion API capability, or an
# internal connection API token with read/update content access.
# If using an internal connection, add it to the 💌 Collab Tracker database.
NOTION_TOKEN=
PORT=3001

# Google Cloud OAuth Web application; keep these server-side only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GMAIL_COOKIE_KEY=
GMAIL_REDIRECT_URI=http://127.0.0.1:3001/api/gmail/auth/callback
GMAIL_APP_ORIGIN=http://127.0.0.1:5173

# Meta Unified Login app secret and webhook verification token.
# The webhook callback is https://collab-pipeline.vercel.app/api/meta/webhook.
META_CLIENT_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_CLIENT_ID=
META_CONFIG_ID=
# Instagram professional account ID shown by Meta, used to limit inbox access.
META_IG_ACCOUNT_ID=
META_REDIRECT_URI=http://127.0.0.1:5173/api/meta/auth/callback
# Required on Vercel. Local development can use temporary in-memory sessions.
META_SESSION_REDIS_URL=
META_SESSION_REDIS_TOKEN=
